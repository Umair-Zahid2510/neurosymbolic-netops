# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- LLM provider selection -------------------------------------------------
# NETOPS_LLM_MODE: llm | rule_based | offline
#   llm        live provider call; fails loudly if the key is missing (no silent fallback)
#   rule_based deterministic baseline, no model
#   offline    replay of recorded LLM responses from a cassette (always labelled "replay")
NETOPS_LLM_MODE=rule_based
NETOPS_LLM_PROVIDER=gemini            # gemini | openai
NETOPS_LLM_MODEL=gemini-3.6-flash     # or e.g. gpt-4.1-mini for openai
NETOPS_LLM_TIMEOUT_S=60
NETOPS_LLM_MAX_RETRIES=4
NETOPS_LLM_TEMPERATURE=0.2
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Verification -------------------------------------------------------------
NETOPS_VERIFIER=local                 # local | batfish
BATFISH_HOST=localhost

# --- Actuation / audit ----------------------------------------------------------
NETOPS_ACTUATION_ADAPTER=inmemory     # inmemory | frr_docker
NETOPS_AUDIT_HMAC_KEY=change-me-to-a-long-random-string
# MCP write tools require a role and a one-time approval token bound to a verified plan hash
NETOPS_MCP_ROLE=read                  # read | verify | operator
