    "Spine-2": {
      "asn": 65000,
      "role": "spine",
      "interfaces": {
        "eth1": {"ip": "10.0.3.1/30", "peer_node": "Leaf-1", "peer_intf": "eth2", "peer_ip": "10.0.3.2", "peer_asn": 65001},
        "eth2": {"ip": "10.0.4.1/30", "peer_node": "Leaf-2", "peer_intf": "eth2", "peer_ip": "10.0.4.2", "peer_asn": 65002}
