        "eth1": {"ip": "10.0.1.1/30", "peer_node": "Leaf-1", "peer_intf": "eth1", "peer_ip": "10.0.1.2", "peer_asn": 65001},
        "eth2": {"ip": "10.0.2.1/30", "peer_node": "Leaf-2", "peer_intf": "eth1", "peer_ip": "10.0.2.2", "peer_asn": 65002}
